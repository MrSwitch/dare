{
	"name": "dare",
	"version": "2.0.1",
	"description": "Database to REST, REST to Database",
	"type": "module",
	"main": "./dist/index.js",
	"exports": {
		".": {
			"types": "./types/src/index.d.ts",
			"import": "./dist/index.js"
		},
		"./mariadb11": {
			"types": "./types/src/index.d.ts",
			"import": "./dist/index.js"
		},
		"./mysql57": {
			"types": "./types/src/mysql57.d.ts",
			"import": "./dist/mysql57.js"
		},
		"./mysql80": {
			"types": "./types/src/index.d.ts",
			"import": "./dist/index.js"
		},
		"./postgres16": {
			"types": "./types/src/postgres16.d.ts",
			"import": "./dist/postgres16.js"
		},
		"./sqlite3": {
			"types": "./types/src/sqlite.d.ts",
			"import": "./dist/sqlite.js"
		},
		"./utils/*": {
			"types": "./types/src/utils/*.d.ts",
			"import": "./dist/utils/*.js"
		}
	},
	"types": "./types/src/index.d.ts",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"prepare": "is-ci || husky install",
		"build": "tsc -p ./tsconfig.build.json",
		"prepack": "npm run build && npm run check-types",
		"check-types": "tsc -p ./tsconfig.json && node scripts/rewrite-dts-extensions.ts",
		"test": "npm run lint && npm run spec && ((c8 report --reporter=text-lcov | coveralls) || exit 0)",
		"test:ci": "npm run lint && c8 node --test 'test/specs/**/*.spec.ts' && (c8 report --reporter=text-lcov | coveralls)",
		"test:integration": "bash ./test/integration/run.sh",
		"test:integration:sqlite": "DB_ENGINE=sqlite:3 bash ./test/integration/run.sh",
		"spec": "c8 node --test 'test/specs/**/*.spec.ts'",
		"lint": "eslint ./ && npx prettier --check . && npm run check-types",
		"prettier": "prettier --write --ignore-unknown .",
		"lint-fix": "eslint --fix ./",
		"lint-diff": "LIST=`git diff-index --cached --name-only --diff-filter=d HEAD | grep '.*\\.ts$';`; if [ \"$LIST\" ]; then eslint $LIST; fi",
		"lint-diff-fix": "LIST=`git diff-index --name-only --diff-filter=d HEAD | grep '.*\\.ts$';`; if [ \"$LIST\" ]; then eslint --fix $LIST; fi"
	},
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/MrSwitch/dare.git"
	},
	"keywords": [
		"Database",
		"MySQL",
		"REST"
	],
	"author": "Andrew Dodson",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/MrSwitch/dare/issues"
	},
	"homepage": "https://github.com/MrSwitch/dare#readme",
	"files": [
		"src/",
		"dist/",
		"types/src/"
	],
	"devDependencies": {
		"@5app/prettier-config": "^1.0.4",
		"@5app/semantic-release-config": "^2.0.0",
		"@commitlint/cli": "^21.0.1",
		"@commitlint/config-conventional": "^21.0.1",
		"@types/mocha": "^10.0.10",
		"c8": "^12.0.0",
		"coveralls-next": "^6.0.1",
		"debug": "^4.4.3",
		"eslint": "^10.4.0",
		"eslint-config-5app": "^1.0.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-n": "^18.0.1",
		"eslint-plugin-promise": "^7.3.0",
		"eslint-plugin-security": "^4.0.0",
		"globals": "^17.6.0",
		"husky": "^9.1.7",
		"is-ci": "^4.1.0",
		"jiti": "^2.7.0",
		"mocha": "^11.7.5",
		"mysql2": "3.22",
		"pg": "^8.20.0",
		"pg-query-stream": "^4.14.0",
		"prettier": "^3.8.3",
		"semantic-release": "^25.0.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.69.0"
	},
	"dependencies": {
		"semver-compare": "^1.0.0",
		"sql-template-tag": "^5.2.1",
		"tricks": "^2.4.0"
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	},
	"prettier": "@5app/prettier-config",
	"release": {
		"extends": "@5app/semantic-release-config"
	}
}
